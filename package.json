{
  "name": "huquqiy-yordamchi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node server.js\" \"vite\"",
    "build": "vite build",
    "lint": "oxlint",
    "test": "node --test tests/*.test.js",
    "import:legal": "node scripts/import-lexuz.js",
    "academy:admin": "node scripts/set-academy-admin.js",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .\"",
    "desktop:build": "cross-env ELECTRON_BUILD=1 vite build && electron-builder --win nsis"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "uz.huquqiy.yordamchi",
    "productName": "Huquqiy yordamchi",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.js",
      "migrations/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Huquqiy-yordamchi-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5",
    "wait-on": "^8.0.4"
  },
  "allowScripts": {
    "electron@39.8.10": true
  }
}
